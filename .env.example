# Copy to .env and fill in. .env is git-ignored; never commit real secrets.

# Required. Signs dashboard login tokens. At least 32 random characters.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Optional. Enables AI root-cause suggestions and post-mortem drafts. Without it, incidents still work
# and the AI panel shows "not configured". Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# Database credentials used by docker compose (defaults: pulseops / pulseops).
DB_USER=pulseops
DB_PASSWORD=pulseops
